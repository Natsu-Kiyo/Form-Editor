// 轻问卷 · 数据模型
//
// 约定：
// 1. 数据库为 PostgreSQL（Neon）。不写任何 SQLite 专用语法。
// 2. 连接串不在这里配置 —— Prisma 7 起，url / directUrl 移到根目录 prisma.config.ts。
// 3. 迁移只增不改：已应用的迁移文件永不编辑，修正靠新增迁移。
// 4. 字段与枚举值用英文（大写下划线给枚举）；中文文案统一放 src/config/constants.ts。
// 5. 模型清单与字段说明见 docs/PLAN.md §5。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// M1 · 账号、会话与工作区
// ============================================================

/// 工作区角色，权限由深到浅：所有者 > 管理员 > 编辑者 > 查看者
enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// 上次修改密码的时间。账号与安全里要如实展示（设计稿 W11 的「上次修改 x」）
  passwordUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  memberships    Membership[]
  ownedWorkspaces Workspace[]          @relation("WorkspaceOwner")
  notifications  Notification[]
  feedbacks      Feedback[]
  questionnaires Questionnaire[]       @relation("QuestionnaireOwner")
  templates      Template[]            @relation("TemplateOwner")
  responses      Response[]            @relation("ResponseRespondent")
  invalidatedResponses Response[]      @relation("ResponseInvalidator")
  versions       QuestionnaireVersion[] @relation("VersionAuthor")
  operationLogs  OperationLog[]         @relation("OperationActor")
}

/// 服务端会话。Cookie 里只放原始 token，库里存它的 sha256 —— 库泄露也无法直接冒用
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  questionnaires Questionnaire[]
  templates   Template[]
  operationLogs OperationLog[]

  @@index([ownerId])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// 站内通知。类型用字符串而非枚举 —— 类型会随里程碑增长，文案在 constants.ts 映射
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// 帮助与反馈弹层里提交的内容
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  category  String
  content   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ============================================================
// M2 · 问卷、题目结构与模板
// ============================================================

/// 问卷状态机：草稿 → 回收中 ⇄ 已暂停 → 已截止，随时可归档
enum QuestionnaireStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

/// 作答者身份要求（发布设置里选，M4）
enum IdentityMode {
  ANONYMOUS
  LOGIN_REQUIRED
  PASSWORD
}

/// 关闭原因。列表与详情据此给出不同提示，「手动恢复」只对 MANUAL 有意义
enum CloseReason {
  MANUAL
  SCHEDULED
  LIMIT_REACHED
  ADMIN
}

/// 题型。矩阵题是 1.1 的灰显项，不在此列
enum QuestionType {
  SINGLE
  MULTI
  SHORT_TEXT
  LONG_TEXT
  RATING
  DROPDOWN
  DATE
}

model Questionnaire {
  id            String              @id @default(cuid())
  workspaceId   String
  ownerId       String
  title         String
  intro         String?
  status        QuestionnaireStatus @default(DRAFT)
  /// 公开作答链接里的短标识
  slug          String              @unique
  startsAt      DateTime?
  endsAt        DateTime?
  /// 回收上限。列表卡片的「128 / 200」用它的分母
  responseLimit Int?
  identityMode  IdentityMode        @default(ANONYMOUS)
  accessPasswordHash String?
  closeReason   CloseReason?
  publishedAt   DateTime?
  closedAt      DateTime?
  archivedAt    DateTime?
  /// 题目结构版本号。发布时 +1，M3 的版本历史用它
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User          @relation("QuestionnaireOwner", fields: [ownerId], references: [id])
  questions  Question[]
  responses  Response[]
  channels   Channel[]
  versions   QuestionnaireVersion[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([ownerId])
}

model Question {
  id              String       @id @default(cuid())
  questionnaireId String
  type            QuestionType
  title           String
  description     String?
  required        Boolean      @default(false)
  shuffleOptions  Boolean      @default(false)
  /// 题内顺序（0 起）。**不加唯一约束** —— 拖拽重排时中间态必然出现重复序号，
  /// 加了唯一约束就得把重排写成「先挪到哨兵值再回填」，得不偿失
  order           Int
  /// 所在页号（0 起）。M3 的「添加分页」用它
  pageIndex       Int          @default(0)
  /// 题型差异项：评分范围、文本长度上限等
  config          Json?

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  options       Option[]
  answers       Answer[]

  @@index([questionnaireId, order])
}

model Option {
  id         String @id @default(cuid())
  questionId String
  label      String
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

/// 答卷是否计入统计。作废不删除 —— 数据要能解释「为什么少了 3 份」
enum ResponseStatus {
  VALID
  INVALID
}

/// 一份答卷。
///
/// M2 只建表并让列表卡片的「回收进度」与汇总卡的「累计答卷」有真实来源；
/// 作答流程在 M5、统计在 M6、作废在 M7。
model Response {
  id              String         @id @default(cuid())
  questionnaireId String
  channelId       String?
  /// 登录作答时记录；匿名作答为空
  respondentId    String?
  /// 匿名作答的浏览器指纹，用于「同一浏览器重复提交」判定
  fingerprint     String?
  status          ResponseStatus @default(VALID)
  invalidReason   String?
  invalidatedById String?
  invalidatedAt   DateTime?
  submittedAt     DateTime       @default(now())
  userAgent       String?

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  channel       Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  respondent    User?         @relation("ResponseRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  invalidatedBy User?         @relation("ResponseInvalidator", fields: [invalidatedById], references: [id], onDelete: SetNull)
  answers       Answer[]

  @@unique([questionnaireId, respondentId])
  @@unique([questionnaireId, fingerprint])
  @@index([questionnaireId, status])
  @@index([questionnaireId, submittedAt])
}

/// 单题作答值。`value` 用 Json 承载多态：字符串 / 数字 / 字符串数组
model Answer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  value      Json

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
}

/// 分发渠道。分享页的渠道表由它驱动，`?src=` 参数按 `srcToken` 归属到渠道。
model Channel {
  id              String   @id @default(cuid())
  questionnaireId String
  name            String
  /// 链接参数里的渠道标识（`?src=wechat`）
  srcToken        String   @unique
  createdAt       DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  responses     Response[]

  @@index([questionnaireId])
}

/// 题目结构的版本快照。
///
/// 每次**发布**写一条，**回滚**也写一条（回滚不删除任何历史版本 —— 设计稿 W11 的原文）。
/// `snapshot` 与「导出 JSON」是同一套 schema，所以回滚可以直接复用结构替换的逻辑。
model QuestionnaireVersion {
  id              String   @id @default(cuid())
  questionnaireId String
  version         Int
  snapshot        Json
  /// 这个版本是怎么来的：「发布」「回滚自 v2」
  label           String
  createdById     String?
  createdAt       DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("VersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([questionnaireId, version])
  @@index([questionnaireId, version])
}

/// 操作日志。版本历史抽屉与 M10 的操作日志页都读它。
/// `type` 用字符串而非枚举：类型会随里程碑增长，文案在 constants.ts 映射。
model OperationLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  type        String
  targetType  String
  targetId    String
  targetName  String
  detail      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("OperationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
}

/// 模板。官方模板由 seed 写入（`isOfficial = true`，`workspaceId` 为空）
model Template {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String
  questionCount Int
  /// 题目结构快照，与「导出 JSON」是同一套结构
  payload       Json
  isOfficial    Boolean  @default(false)
  workspaceId   String?
  ownerId       String?
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?      @relation("TemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([isOfficial, category])
  @@index([workspaceId])
}
