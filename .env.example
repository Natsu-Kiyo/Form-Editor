# 环境变量模板：复制为 .env 后填入真实值
# 注意：.gitignore 里的 `.env*` 会把本文件也忽略掉，
# 若希望它进仓库，请在 .gitignore 中追加一行 `!.env.example`

# 【必填】运行时连接串。生产环境填写 Neon 的池化连接串
# （Vercel → Storage → Neon 集成会自动注入 DATABASE_URL）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1"

# 【必填】迁移专用直连串，绕过池化（Neon 控制台里的 unpooled 连接串）
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 【必填】会话与令牌签名密钥，至少 32 字符。生成：openssl rand -base64 32
AUTH_SECRET=""

# 【必填】应用对外地址。本地为 http://localhost:3000，生产为正式域名
NEXT_PUBLIC_APP_URL="http://localhost:3000"
